{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests/*.test.ts", "vite.config.ts"],
  "exclude": [
    "src/core/GameState.ts",
    "src/core/init.ts",
    "src/ui/ProfilePanel.ts"
  ]
}
